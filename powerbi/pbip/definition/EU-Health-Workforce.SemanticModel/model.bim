        {
          "name": "Worker to Population Ratio",
          "expression": "VAR Workers = [Total Workers]\nVAR Population =\n    CALCULATE ( SUM ( fact_population[population] ) )\nRETURN\n    DIVIDE ( Workers, Population ) * 1000\n\n// Population-weighted, so a micro-state cannot dominate an EU-wide figure.\nPopulation Weighted Coverage :=\nVAR WeightedCoverage =\n    SUMX (\n        SUMMARIZE ( dim_country, dim_country[country_code] ),\n        VAR Pop = CALCULATE ( SUM ( fact_population[population] ) )\n        VAR Workers =\n            CALCULATE (\n                SUM ( fact_healthcare_workers[measure_value] ),\n                fact_healthcare_workers[measure] = \"headcount_total\",\n                fact_healthcare_workers[sex_code] = \"T\"\n            )\n        RETURN\n            DIVIDE ( Workers, Pop ) * 1000 * Pop\n    )\nRETURN\n    DIVIDE ( WeightedCoverage, CALCULATE ( SUM ( fact_population[population] ) ) )\n\n// True only where the country actually reported. Use this to grey out cards\n// rather than letting a missing value read as zero.\nPhysicians Reported :=\nISBLANK (\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_total\",\n        fact_healthcare_workers[sex_code] = \"T\",\n        fact_healthcare_workers[profession_code] = \"PHYS\"\n    )\n) = FALSE\n\nNurses Reported :=\nISBLANK (\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_total\",\n        fact_healthcare_workers[sex_code] = \"T\",\n        fact_healthcare_workers[profession_code] = \"NURS\"\n    )\n) = FALSE\n\n// Countries in scope for the current visual. Six member states publish no\n// nurse data at all; counting them would understate EU coverage.\nCountries Reporting Nurses :=\nVAR Unreported =\n    CALCULATETABLE (\n        VALUES ( dim_country[country_code] ),\n        FILTER (\n            VALUES ( dim_country[country_code] ),\n            ISBLANK (\n                CALCULATE (\n                    SUM ( fact_healthcare_workers[measure_value] ),\n                    fact_healthcare_workers[measure] = \"headcount_total\",\n                    fact_healthcare_workers[sex_code] = \"T\",\n                    fact_healthcare_workers[profession_code] = \"NURS\"\n                )\n            )\n        )\n    )\nRETURN\n    COUNTROWS ( dim_country ) - COUNTROWS ( Unreported )",
          "formatString": "0.0%",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Population Weighted Coverage",
          "expression": "VAR WeightedCoverage =\n    SUMX (\n        SUMMARIZE ( dim_country, dim_country[country_code] ),\n        VAR Pop = CALCULATE ( SUM ( fact_population[population] ) )\n        VAR Workers =\n            CALCULATE (\n                SUM ( fact_healthcare_workers[measure_value] ),\n                fact_healthcare_workers[measure] = \"headcount_total\",\n                fact_healthcare_workers[sex_code] = \"T\"\n            )\n        RETURN\n            DIVIDE ( Workers, Pop ) * 1000 * Pop\n    )\nRETURN\n    DIVIDE ( WeightedCoverage, CALCULATE ( SUM ( fact_population[population] ) ) )\n\n// True only where the country actually reported. Use this to grey out cards\n// rather than letting a missing value read as zero.\nPhysicians Reported :=\nISBLANK (\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_total\",\n        fact_healthcare_workers[sex_code] = \"T\",\n        fact_healthcare_workers[profession_code] = \"PHYS\"\n    )\n) = FALSE\n\nNurses Reported :=\nISBLANK (\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_total\",\n        fact_healthcare_workers[sex_code] = \"T\",\n        fact_healthcare_workers[profession_code] = \"NURS\"\n    )\n) = FALSE\n\n// Countries in scope for the current visual. Six member states publish no\n// nurse data at all; counting them would understate EU coverage.\nCountries Reporting Nurses :=\nVAR Unreported =\n    CALCULATETABLE (\n        VALUES ( dim_country[country_code] ),\n        FILTER (\n            VALUES ( dim_country[country_code] ),\n            ISBLANK (\n                CALCULATE (\n                    SUM ( fact_healthcare_workers[measure_value] ),\n                    fact_healthcare_workers[measure] = \"headcount_total\",\n                    fact_healthcare_workers[sex_code] = \"T\",\n                    fact_healthcare_workers[profession_code] = \"NURS\"\n                )\n            )\n        )\n    )\nRETURN\n    COUNTROWS ( dim_country ) - COUNTROWS ( Unreported )",
          "formatString": "#,0",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Physicians Reported",
