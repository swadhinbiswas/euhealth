    {
      "name": "_measures",
      "columns": [],
      "partitions": [],
      "measures": [
        {
          "name": "Total Doctors",
          "expression": "VAR LatestYear := MAX ( dim_date[year] )\nRETURN\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_total\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    fact_healthcare_workers[profession_code] = \"PHYS\",\n    dim_date[year] = LatestYear\n)\n\nTotal Nurses :=\nVAR LatestYear := MAX ( dim_date[year] )\nRETURN\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_total\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    fact_healthcare_workers[profession_code] = \"NURS\",\n    dim_date[year] = LatestYear\n)\n\nTotal Workers :=\nVAR LatestYear := MAX ( dim_date[year] )\nRETURN\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_total\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    dim_date[year] = LatestYear\n)\n\n// Required workforce at the reference staffing ratio.\n// Recomputed from population rather than averaged, because averaging a\n// precomputed required figure gives every country equal weight regardless of\n// size, which understates the gap in large countries.\nRequired Workers :=\nDIVIDE (\n    SUM ( fact_staffing_shortage[required_workers] ),\n    COUNTROWS ( fact_staffing_shortage )\n)\n\n// Absolute gap: required minus actual. Positive means a shortage.\nWorkforce Gap :=\nSUM ( fact_staffing_shortage[shortage] )\n\n// Signed gap as a percentage of requirement. This is the headline KPI on\n// page 1: a positive value means understaffed.\nWorkforce Gap % :=\nVAR Required = SUM ( fact_staffing_shortage[required_workers] )\nVAR Gap = SUM ( fact_staffing_shortage[shortage] )\nRETURN\n    DIVIDE ( Gap, Required )\n\n// Coverage index: actual as a percentage of the reference ratio. 100 means\n// exactly at the OECD benchmark.\nStaffing Sufficiency :=\nVAR Required = SUM ( fact_staffing_shortage[required_workers] )\nVAR Actual = SUM ( fact_staffing_shortage[actual_workers] )\nRETURN\n    DIVIDE ( Actual, Required )\n\n// Share of the workforce aged 55 or over. The primary retirement exposure.\nRetirement Risk % :=\nVAR TotalByAge =\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_by_age\",\n        fact_healthcare_workers[sex_code] = \"T\"\n    )\nVAR NearRetirement =\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_by_age\",\n        fact_healthcare_workers[sex_code] = \"T\",\n        fact_healthcare_workers[age_group_code] IN { \"Y55_64\", \"Y_GE65\" }\n    )\nRETURN\n    DIVIDE ( NearRetirement, TotalByAge )\n\n// Share aged 65 or over: the group closest to actual exit.\nRetirement Exposure 65+ :=\nVAR TotalByAge =\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_by_age\",\n        fact_healthcare_workers[sex_code] = \"T\"\n    )\nRETURN\n    DIVIDE (\n        CALCULATE (\n            SUM ( fact_healthcare_workers[measure_value] ),\n            fact_healthcare_workers[measure] = \"headcount_by_age\",\n            fact_healthcare_workers[sex_code] = \"T\",\n            fact_healthcare_workers[age_group_code] = \"Y_GE65\"\n        ),\n        TotalByAge\n    )\n\n// Absolute number of workers in retirement-age bands.\nNear Retirement Workers :=\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_by_age\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    fact_healthcare_workers[age_group_code] IN { \"Y55_64\", \"Y_GE65\" }\n)\n\n// ICU intensity: intensive care beds as a share of all hospital beds.\nHospital Readiness :=\nVAR ICU = CALCULATE ( SUM ( fact_hospital_capacity[beds] ), fact_hospital_capacity[category_group] = \"icu_bed\" )\nVAR AllBeds = CALCULATE ( SUM ( fact_hospital_capacity[beds] ), fact_hospital_capacity[category_group] = \"hospital_bed\" )\nRETURN\n    DIVIDE ( ICU, AllBeds )\n\nHospital Beds :=\nCALCULATE (\n    SUM ( fact_hospital_capacity[beds] ),\n    fact_hospital_capacity[category_group] = \"hospital_bed\"\n)\n\nICU Beds :=\nCALCULATE (\n    SUM ( fact_hospital_capacity[beds] ),\n    fact_hospital_capacity[category_group] = \"icu_bed\"\n)",
          "formatString": "#,0.00",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Total Nurses",
          "expression": "VAR LatestYear := MAX ( dim_date[year] )\nRETURN\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_total\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    fact_healthcare_workers[profession_code] = \"NURS\",\n    dim_date[year] = LatestYear\n)\n\nTotal Workers :=\nVAR LatestYear := MAX ( dim_date[year] )\nRETURN\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_total\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    dim_date[year] = LatestYear\n)\n\n// Required workforce at the reference staffing ratio.\n// Recomputed from population rather than averaged, because averaging a\n// precomputed required figure gives every country equal weight regardless of\n// size, which understates the gap in large countries.\nRequired Workers :=\nDIVIDE (\n    SUM ( fact_staffing_shortage[required_workers] ),\n    COUNTROWS ( fact_staffing_shortage )\n)\n\n// Absolute gap: required minus actual. Positive means a shortage.\nWorkforce Gap :=\nSUM ( fact_staffing_shortage[shortage] )\n\n// Signed gap as a percentage of requirement. This is the headline KPI on\n// page 1: a positive value means understaffed.\nWorkforce Gap % :=\nVAR Required = SUM ( fact_staffing_shortage[required_workers] )\nVAR Gap = SUM ( fact_staffing_shortage[shortage] )\nRETURN\n    DIVIDE ( Gap, Required )\n\n// Coverage index: actual as a percentage of the reference ratio. 100 means\n// exactly at the OECD benchmark.\nStaffing Sufficiency :=\nVAR Required = SUM ( fact_staffing_shortage[required_workers] )\nVAR Actual = SUM ( fact_staffing_shortage[actual_workers] )\nRETURN\n    DIVIDE ( Actual, Required )\n\n// Share of the workforce aged 55 or over. The primary retirement exposure.\nRetirement Risk % :=\nVAR TotalByAge =\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_by_age\",\n        fact_healthcare_workers[sex_code] = \"T\"\n    )\nVAR NearRetirement =\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_by_age\",\n        fact_healthcare_workers[sex_code] = \"T\",\n        fact_healthcare_workers[age_group_code] IN { \"Y55_64\", \"Y_GE65\" }\n    )\nRETURN\n    DIVIDE ( NearRetirement, TotalByAge )\n\n// Share aged 65 or over: the group closest to actual exit.\nRetirement Exposure 65+ :=\nVAR TotalByAge =\n    CALCULATE (\n        SUM ( fact_healthcare_workers[measure_value] ),\n        fact_healthcare_workers[measure] = \"headcount_by_age\",\n        fact_healthcare_workers[sex_code] = \"T\"\n    )\nRETURN\n    DIVIDE (\n        CALCULATE (\n            SUM ( fact_healthcare_workers[measure_value] ),\n            fact_healthcare_workers[measure] = \"headcount_by_age\",\n            fact_healthcare_workers[sex_code] = \"T\",\n            fact_healthcare_workers[age_group_code] = \"Y_GE65\"\n        ),\n        TotalByAge\n    )\n\n// Absolute number of workers in retirement-age bands.\nNear Retirement Workers :=\nCALCULATE (\n    SUM ( fact_healthcare_workers[measure_value] ),\n    fact_healthcare_workers[measure] = \"headcount_by_age\",\n    fact_healthcare_workers[sex_code] = \"T\",\n    fact_healthcare_workers[age_group_code] IN { \"Y55_64\", \"Y_GE65\" }\n)\n\n// ICU intensity: intensive care beds as a share of all hospital beds.\nHospital Readiness :=\nVAR ICU = CALCULATE ( SUM ( fact_hospital_capacity[beds] ), fact_hospital_capacity[category_group] = \"icu_bed\" )\nVAR AllBeds = CALCULATE ( SUM ( fact_hospital_capacity[beds] ), fact_hospital_capacity[category_group] = \"hospital_bed\" )\nRETURN\n    DIVIDE ( ICU, AllBeds )\n\nHospital Beds :=\nCALCULATE (\n    SUM ( fact_hospital_capacity[beds] ),\n    fact_hospital_capacity[category_group] = \"hospital_bed\"\n)\n\nICU Beds :=\nCALCULATE (\n    SUM ( fact_hospital_capacity[beds] ),\n    fact_hospital_capacity[category_group] = \"icu_bed\"\n)",
