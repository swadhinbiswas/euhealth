        {
          "name": "Countries Reporting Nurses",
          "expression": "VAR Unreported =\n    CALCULATETABLE (\n        VALUES ( dim_country[country_code] ),\n        FILTER (\n            VALUES ( dim_country[country_code] ),\n            ISBLANK (\n                CALCULATE (\n                    SUM ( fact_healthcare_workers[measure_value] ),\n                    fact_healthcare_workers[measure] = \"headcount_total\",\n                    fact_healthcare_workers[sex_code] = \"T\",\n                    fact_healthcare_workers[profession_code] = \"NURS\"\n                )\n            )\n        )\n    )\nRETURN\n    COUNTROWS ( dim_country ) - COUNTROWS ( Unreported )",
          "formatString": "#,0",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Shortage Severity Rank",
          "expression": "VAR Shortage = [Workforce Gap]\nRETURN\n    IF (\n        NOT ISBLANK ( Shortage ),\n        RANKX (\n            ALLSELECTED ( dim_country[country_code] ),\n            CALCULATE ( [Workforce Gap] ),\n            ,\n            DESC,\n            DENSE\n        )\n    )\n\n// Year-over-year change in the gap. Negative means the position improved.\nGap YoY Change :=\nVAR Current = [Workforce Gap]\nVAR Prior =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    Current - Prior\n\n// Three-year rolling mean of the gap, so one unusual year does not read as a\n// trend. Uses the date table, not a row-wise window.\nGap Rolling 3Y :=\nVAR CurrentGap = [Workforce Gap]\nVAR Window =\n    DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -3, YEAR )\nRETURN\n    AVERAGEX (\n        Window,\n        CALCULATE ( [Workforce Gap] )\n    )\n\n// Countries whose coverage index is deteriorating year on year.\nDeteriorating Countries :=\nVAR PriorYear = CALCULATE ( MAX ( dim_date[year] ), DATEADD ( dim_date[Date], -1, YEAR ) )\nVAR CurrentYear = MAX ( dim_date[year] )\nVAR Deteriorated =\n    FILTER (\n        ALL ( dim_country[country_code] ),\n        VAR C = [Staffing Sufficiency]\n        VAR P =\n            CALCULATE (\n                [Staffing Sufficiency],\n                dim_country[country_code] = dim_country[country_code],\n                dim_date[year] = PriorYear\n            )\n        RETURN\n            NOT ISBLANK ( C ) && NOT ISBLANK ( P ) && C < P\n    )\nRETURN\n    COUNTROWS ( Deteriorated )",
          "formatString": "#,0.00",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Gap YoY Change",
          "expression": "VAR Current = [Workforce Gap]\nVAR Prior =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    Current - Prior\n\n// Three-year rolling mean of the gap, so one unusual year does not read as a\n// trend. Uses the date table, not a row-wise window.\nGap Rolling 3Y :=\nVAR CurrentGap = [Workforce Gap]\nVAR Window =\n    DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -3, YEAR )\nRETURN\n    AVERAGEX (\n        Window,\n        CALCULATE ( [Workforce Gap] )\n    )\n\n// Countries whose coverage index is deteriorating year on year.\nDeteriorating Countries :=\nVAR PriorYear = CALCULATE ( MAX ( dim_date[year] ), DATEADD ( dim_date[Date], -1, YEAR ) )\nVAR CurrentYear = MAX ( dim_date[year] )\nVAR Deteriorated =\n    FILTER (\n        ALL ( dim_country[country_code] ),\n        VAR C = [Staffing Sufficiency]\n        VAR P =\n            CALCULATE (\n                [Staffing Sufficiency],\n                dim_country[country_code] = dim_country[country_code],\n                dim_date[year] = PriorYear\n            )\n        RETURN\n            NOT ISBLANK ( C ) && NOT ISBLANK ( P ) && C < P\n    )\nRETURN\n    COUNTROWS ( Deteriorated )",
          "formatString": "#,0.00",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Gap Rolling 3Y",
          "expression": "VAR CurrentGap = [Workforce Gap]\nVAR Window =\n    DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -3, YEAR )\nRETURN\n    AVERAGEX (\n        Window,\n        CALCULATE ( [Workforce Gap] )\n    )\n\n// Countries whose coverage index is deteriorating year on year.\nDeteriorating Countries :=\nVAR PriorYear = CALCULATE ( MAX ( dim_date[year] ), DATEADD ( dim_date[Date], -1, YEAR ) )\nVAR CurrentYear = MAX ( dim_date[year] )\nVAR Deteriorated =\n    FILTER (\n        ALL ( dim_country[country_code] ),\n        VAR C = [Staffing Sufficiency]\n        VAR P =\n            CALCULATE (\n                [Staffing Sufficiency],\n                dim_country[country_code] = dim_country[country_code],\n                dim_date[year] = PriorYear\n            )\n        RETURN\n            NOT ISBLANK ( C ) && NOT ISBLANK ( P ) && C < P\n    )\nRETURN\n    COUNTROWS ( Deteriorated )",
          "formatString": "#,0.00",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Deteriorating Countries",
          "expression": "VAR PriorYear = CALCULATE ( MAX ( dim_date[year] ), DATEADD ( dim_date[Date], -1, YEAR ) )\nVAR CurrentYear = MAX ( dim_date[year] )\nVAR Deteriorated =\n    FILTER (\n        ALL ( dim_country[country_code] ),\n        VAR C = [Staffing Sufficiency]\n        VAR P =\n            CALCULATE (\n                [Staffing Sufficiency],\n                dim_country[country_code] = dim_country[country_code],\n                dim_date[year] = PriorYear\n            )\n        RETURN\n            NOT ISBLANK ( C ) && NOT ISBLANK ( P ) && C < P\n    )\nRETURN\n    COUNTROWS ( Deteriorated )",
          "formatString": "#,0",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Workforce Aging Index",
          "expression": "RETURNFILTERVALUES ( dim_age_group, RETURNSUBSTITUTE ( [Retirement Risk %] ) )\n\n// Relative position against the EU average, useful for a conditional-format\n// card without hard-coding a benchmark per country.\nAging vs EU Average :=\nVAR Mine = [Retirement Risk %]\nVAR EUMean = CALCULATE ( [Retirement Risk %], ALL ( dim_country ) )\nRETURN\n    DIVIDE ( Mine - EUMean, EUMean )\n\n// Replacement demand: workers in retirement bands as an absolute headcount.\nReplacement Demand :=\n[Near Retirement Workers]",
          "formatString": "0.0%",
          "displayFolder": "2 \u00b7 Retirement exposure"
        },
        {
          "name": "Aging vs EU Average",
          "expression": "VAR Mine = [Retirement Risk %]\nVAR EUMean = CALCULATE ( [Retirement Risk %], ALL ( dim_country ) )\nRETURN\n    DIVIDE ( Mine - EUMean, EUMean )\n\n// Replacement demand: workers in retirement bands as an absolute headcount.\nReplacement Demand :=\n[Near Retirement Workers]",
          "formatString": "#,0.00",
          "displayFolder": "2 \u00b7 Retirement exposure"
        },
        {
          "name": "Replacement Demand",
          "expression": "[Near Retirement Workers]",
          "formatString": "#,0.00",
          "displayFolder": "2 \u00b7 Retirement exposure"
        },
        {
          "name": "Hospital Risk Score",
          "expression": "VAR BedsPerNurse =\n    DIVIDE (\n        [Hospital Beds],\n        CALCULATE (\n            SUM ( fact_healthcare_workers[measure_value] ),\n            fact_healthcare_workers[measure] = \"headcount_total\",\n            fact_healthcare_workers[sex_code] = \"T\",\n            fact_healthcare_workers[profession_code] = \"NURS\"\n        )\n    )\nVAR ReferenceBedsPerNurse = 0.8\nVAR WorkforcePressure =\n    MIN ( 1, DIVIDE ( ReferenceBedsPerNurse, BedsPerNurse ) )\nVAR ICUScarcity =\n    MIN ( 1, DIVIDE ( 0.04, [Hospital Readiness] ) )\nVAR RetirementPressure = MIN ( 1, [Retirement Risk %] / 0.6 )\nRETURN\n    ROUND (\n        ( WorkforcePressure * 0.40 + ICUScarcity * 0.35 + RetirementPressure * 0.25 )\n        * 100,\n        1\n    )\n\n// Discrete tier so the score is actionable rather than a continuous number\n// nobody can act on.\nHospital Risk Tier :=\nVAR Score = [Hospital Risk Score]\nRETURN\n    SWITCH (\n        TRUE (),\n        ISBLANK ( Score ), \"Unknown\",\n        Score >= 75, \"Critical\",\n        Score >= 50, \"High\",\n        Score >= 25, \"Medium\",\n        \"Low\"\n    )",
          "formatString": "0.0",
          "displayFolder": "3 \u00b7 Hospital capacity"
        },
        {
          "name": "Hospital Risk Tier",
          "expression": "VAR Score = [Hospital Risk Score]\nRETURN\n    SWITCH (\n        TRUE (),\n        ISBLANK ( Score ), \"Unknown\",\n        Score >= 75, \"Critical\",\n        Score >= 50, \"High\",\n        Score >= 25, \"Medium\",\n        \"Low\"\n    )",
          "formatString": "#,0.00",
          "displayFolder": "3 \u00b7 Hospital capacity"
        },
        {
          "name": "Regional Coverage",
          "expression": "VAR Workers =\n    CALCULATE ( SUM ( fact_regional_workforce[measure_value] ) )\nVAR Population =\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\"\n    )\nRETURN\n    DIVIDE ( Workers, Population ) * 1000\n\n// Medical desert score: combines low density with a small population base,\n// because a thinly served region of 20,000 people is a different problem from\n// the same density in a region of 2 million.\nMedical Desert Score :=\nVAR Coverage = [Regional Coverage]\nVAR Population =\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\"\n    )\nVAR DensityPenalty = MIN ( 1, DIVIDE ( 50000, Population ) )\nRETURN\n    IF (\n        ISBLANK ( Coverage ),\n        BLANK (),\n        ROUND ( MIN ( 100, DIVIDE ( 12, Coverage ) * 70 + DensityPenalty * 30 ), 1 )\n    )\n\n// Four action tiers, cut on the observed distribution.\nMedical Desert Tier :=\nVAR Score = [Medical Desert Score]\nRETURN\n    SWITCH (\n        TRUE (),\n        ISBLANK ( Score ), \"Unknown\",\n        Score >= 70, \"Critical\",\n        Score >= 45, \"High\",\n        Score >= 25, \"Medium\",\n        \"Low\"\n    )\n\n// Regions in a critical desert, for the priority-funding page.\nCritical Desert Regions :=\nVAR Critical =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\"\n    )\nRETURN\n    COUNTROWS ( Critical )\n\n// Population affected: the number of people living in critical regions.\n// This is the equity figure for a funding decision.\nPopulation In Deserts :=\nVAR Deserts =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\" || Tier = \"High\"\n    )\nRETURN\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\",\n        KEEPFILTERS ( Deserts )\n    )",
          "formatString": "#,0.00",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Medical Desert Score",
          "expression": "VAR Coverage = [Regional Coverage]\nVAR Population =\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\"\n    )\nVAR DensityPenalty = MIN ( 1, DIVIDE ( 50000, Population ) )\nRETURN\n    IF (\n        ISBLANK ( Coverage ),\n        BLANK (),\n        ROUND ( MIN ( 100, DIVIDE ( 12, Coverage ) * 70 + DensityPenalty * 30 ), 1 )\n    )\n\n// Four action tiers, cut on the observed distribution.\nMedical Desert Tier :=\nVAR Score = [Medical Desert Score]\nRETURN\n    SWITCH (\n        TRUE (),\n        ISBLANK ( Score ), \"Unknown\",\n        Score >= 70, \"Critical\",\n        Score >= 45, \"High\",\n        Score >= 25, \"Medium\",\n        \"Low\"\n    )\n\n// Regions in a critical desert, for the priority-funding page.\nCritical Desert Regions :=\nVAR Critical =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\"\n    )\nRETURN\n    COUNTROWS ( Critical )\n\n// Population affected: the number of people living in critical regions.\n// This is the equity figure for a funding decision.\nPopulation In Deserts :=\nVAR Deserts =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\" || Tier = \"High\"\n    )\nRETURN\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\",\n        KEEPFILTERS ( Deserts )\n    )",
          "formatString": "0.0",
          "displayFolder": "4 \u00b7 Regional access"
        },
        {
          "name": "Medical Desert Tier",
          "expression": "VAR Score = [Medical Desert Score]\nRETURN\n    SWITCH (\n        TRUE (),\n        ISBLANK ( Score ), \"Unknown\",\n        Score >= 70, \"Critical\",\n        Score >= 45, \"High\",\n        Score >= 25, \"Medium\",\n        \"Low\"\n    )\n\n// Regions in a critical desert, for the priority-funding page.\nCritical Desert Regions :=\nVAR Critical =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\"\n    )\nRETURN\n    COUNTROWS ( Critical )\n\n// Population affected: the number of people living in critical regions.\n// This is the equity figure for a funding decision.\nPopulation In Deserts :=\nVAR Deserts =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\" || Tier = \"High\"\n    )\nRETURN\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\",\n        KEEPFILTERS ( Deserts )\n    )",
          "formatString": "#,0.00",
          "displayFolder": "4 \u00b7 Regional access"
        },
        {
          "name": "Critical Desert Regions",
          "expression": "VAR Critical =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\"\n    )\nRETURN\n    COUNTROWS ( Critical )\n\n// Population affected: the number of people living in critical regions.\n// This is the equity figure for a funding decision.\nPopulation In Deserts :=\nVAR Deserts =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\" || Tier = \"High\"\n    )\nRETURN\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\",\n        KEEPFILTERS ( Deserts )\n    )",
          "formatString": "#,0",
          "displayFolder": "4 \u00b7 Regional access"
        },
        {
          "name": "Population In Deserts",
          "expression": "VAR Deserts =\n    FILTER (\n        ALL ( dim_region[nuts_code] ),\n        VAR Tier = CALCULATE ( [Medical Desert Tier] )\n        RETURN Tier = \"Critical\" || Tier = \"High\"\n    )\nRETURN\n    CALCULATE (\n        SUM ( fact_population_nuts[population] ),\n        fact_population_nuts[age_group_code] IS BLANK (),\n        fact_population_nuts[sex_code] = \"T\",\n        KEEPFILTERS ( Deserts )\n    )",
          "formatString": "#,0",
          "displayFolder": "4 \u00b7 Regional access"
        },
        {
          "name": "Forecasted Gap",
          "expression": "VAR Forecast = [Forecast Workers]\nVAR Required = CALCULATE ( [Required Workers] )\nRETURN\n    Forecast - Required\n\n// Model uplift over the naive baseline, so a reader can see whether the model\n// adds anything or is just carrying the last observed value forward.\nModel Uplift :=\nVAR F = [Forecast Workers]\nVAR B = [Baseline Forecast]\nRETURN\n    F - B\n\n// Direction of travel in the forecast horizon.\nForecast Direction :=\nVAR Change = [Forecast Change %]\nRETURN\n    SWITCH ( TRUE (), ISBLANK ( Change ), \"Unknown\", Change > 1, \"Growing\",\n            Change < -1, \"Shrinking\", \"Stable\" )",
          "formatString": "#,0.00",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Model Uplift",
          "expression": "VAR F = [Forecast Workers]\nVAR B = [Baseline Forecast]\nRETURN\n    F - B\n\n// Direction of travel in the forecast horizon.\nForecast Direction :=\nVAR Change = [Forecast Change %]\nRETURN\n    SWITCH ( TRUE (), ISBLANK ( Change ), \"Unknown\", Change > 1, \"Growing\",\n            Change < -1, \"Shrinking\", \"Stable\" )",
          "formatString": "#,0.00",
          "displayFolder": "5 \u00b7 Forecasting"
        },
        {
          "name": "Forecast Direction",
          "expression": "VAR Change = [Forecast Change %]\nRETURN\n    SWITCH ( TRUE (), ISBLANK ( Change ), \"Unknown\", Change > 1, \"Growing\",\n            Change < -1, \"Shrinking\", \"Stable\" )",
          "formatString": "#,0.00",
          "displayFolder": "5 \u00b7 Forecasting"
        },
        {
          "name": "Coverage Index",
          "expression": "[Staffing Sufficiency]\nFuture Capacity := [Total Workers] + [Forecast Workers] - [Total Workers]\nHealthcare Equity :=\nVAR Spread =\n    CALCULATE (\n        MAXX ( SUMMARIZE ( dim_country, dim_country[country_code] ), [Staffing Sufficiency] )\n        - MINX ( SUMMARIZE ( dim_country, dim_country[country_code] ), [Staffing Sufficiency] ),\n        ALL ( dim_country )\n    )\nRETURN\n    DIVIDE ( 1, 1 + Spread )\nRegional Risk := [Hospital Risk Score]\nRecruitment Efficiency :=\nVAR CurrentGap = [Workforce Gap]\nVAR PriorGap =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    DIVIDE ( PriorGap - CurrentGap, ABS ( PriorGap ) )\nHealthcare Access Score := [Regional Coverage]",
          "formatString": "0.0%",
          "displayFolder": "1 \u00b7 Coverage and gap"
        },
        {
          "name": "Future Capacity",
          "expression": "[Total Workers] + [Forecast Workers] - [Total Workers]\nHealthcare Equity :=\nVAR Spread =\n    CALCULATE (\n        MAXX ( SUMMARIZE ( dim_country, dim_country[country_code] ), [Staffing Sufficiency] )\n        - MINX ( SUMMARIZE ( dim_country, dim_country[country_code] ), [Staffing Sufficiency] ),\n        ALL ( dim_country )\n    )\nRETURN\n    DIVIDE ( 1, 1 + Spread )\nRegional Risk := [Hospital Risk Score]\nRecruitment Efficiency :=\nVAR CurrentGap = [Workforce Gap]\nVAR PriorGap =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    DIVIDE ( PriorGap - CurrentGap, ABS ( PriorGap ) )\nHealthcare Access Score := [Regional Coverage]",
          "formatString": "#,0.00",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Healthcare Equity",
          "expression": "VAR Spread =\n    CALCULATE (\n        MAXX ( SUMMARIZE ( dim_country, dim_country[country_code] ), [Staffing Sufficiency] )\n        - MINX ( SUMMARIZE ( dim_country, dim_country[country_code] ), [Staffing Sufficiency] ),\n        ALL ( dim_country )\n    )\nRETURN\n    DIVIDE ( 1, 1 + Spread )\nRegional Risk := [Hospital Risk Score]\nRecruitment Efficiency :=\nVAR CurrentGap = [Workforce Gap]\nVAR PriorGap =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    DIVIDE ( PriorGap - CurrentGap, ABS ( PriorGap ) )\nHealthcare Access Score := [Regional Coverage]",
          "formatString": "0.0%",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Regional Risk",
          "expression": "[Hospital Risk Score]\nRecruitment Efficiency :=\nVAR CurrentGap = [Workforce Gap]\nVAR PriorGap =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    DIVIDE ( PriorGap - CurrentGap, ABS ( PriorGap ) )\nHealthcare Access Score := [Regional Coverage]",
          "formatString": "#,0.00",
          "displayFolder": "4 \u00b7 Regional access"
        },
        {
          "name": "Recruitment Efficiency",
          "expression": "VAR CurrentGap = [Workforce Gap]\nVAR PriorGap =\n    CALCULATE ( [Workforce Gap], SAMEPERIODLASTYEAR ( dim_date[Date] ) )\nRETURN\n    DIVIDE ( PriorGap - CurrentGap, ABS ( PriorGap ) )\nHealthcare Access Score := [Regional Coverage]",
          "formatString": "#,0.00",
          "displayFolder": "0 \u00b7 Headline KPIs"
        },
        {
          "name": "Healthcare Access Score",
          "expression": "[Regional Coverage]",
          "formatString": "0.0",
          "displayFolder": "4 \u00b7 Regional access"
        },
        {
          "name": "Forecast Workers",
          "expression": "SUM ( fact_forecast[forecast] )",
          "formatString": "#,0",
          "displayFolder": "5 \u00b7 Forecasting"
        },
        {
          "name": "Baseline Forecast",
          "expression": "SUM ( fact_forecast[baseline_forecast] )",
          "formatString": "#,0.00",
          "displayFolder": "5 \u00b7 Forecasting"
        },
        {
          "name": "Forecast Change %",
          "expression": "VAR Latest = CALCULATE ( MAX ( fact_forecast[year] ) )\nVAR LatestValue = CALCULATE (\n    SUM ( fact_forecast[forecast] ),\n    fact_forecast[year] = Latest )\nVAR Baseline = CALCULATE (\n    SUM ( fact_forecast[forecast] ),\n    fact_forecast[year] = Latest - 5 )\nRETURN DIVIDE ( LatestValue - Baseline, Baseline )",
          "formatString": "0.0%",
          "displayFolder": "5 \u00b7 Forecasting"
        }
      ]
    }
  ],
